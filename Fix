local function frame(parent,z)
local f=Instance.new("Frame")
f.BackgroundColor3=Color3.new(1,1,1)
f.BorderSizePixel=0
f.ZIndex=z or 2
f.Parent=parent
return f
end

local function rect(f,x,y,w,h)
f.Position=UDim2.fromOffset(x,y)
f.Size=UDim2.fromOffset(w,h)
end

local function stroke(parent,thickness,trans,col)
local s=Instance.new("UIStroke")
s.ApplyStrokeMode=Enum.ApplyStrokeMode.Border
s.Thickness=thickness
s.Transparency=trans or 0
s.Color=col or dark
s.Parent=parent
return s
end

local function glow(parent,z)
local g=Instance.new("ImageLabel")
g.BackgroundTransparency=1
g.Image="rbxassetid://18245826428"
g.ImageColor3=lavender
g.ImageTransparency=.9
g.ScaleType=Enum.ScaleType.Slice
g.SliceCenter=Rect.new(21,21,79,79)
g.ZIndex=z
g.Parent=parent
return g
end

local function newBox()
local holder=frame(gui,2)
holder.BackgroundTransparency=1
holder.Visible=false

local e={holder=holder,parts={}}
e.glow=glow(holder,1)

e.fill=frame(holder,2)
gradient(e.fill,iceColors,90)

e.full=frame(holder,4)
e.full.BackgroundTransparency=1
e.fullStroke=stroke(e.full,2,0,lavender)
gradient(e.fullStroke,iceColors,0)

for i=1,8 do
local back=frame(holder,3)
back.BackgroundColor3=dark
local front=frame(holder,4)
gradient(front,iceColors,i<=4 and 0 or 90)
e.parts[i]={back,front}
end

return e
end

local function drawBox(e,x,y,w,h)
local C=A.C
local p=e.parts
local length=math.max(4,math.floor(math.min(w,h)*.25+.5))
local t=2
local positions={
{0,0,length,t},
{w-length,0,length,t},
{0,h-t,length,t},
{w-length,h-t,length,t},
{0,0,t,length},
{w-t,0,t,length},
{0,h-length,t,length},
{w-t,h-length,t,length}
}

rect(e.holder,x,y,w,h)
e.holder.Visible=true

e.fill.Visible=C.filled
e.fill.BackgroundTransparency=C.filledTransparency
rect(e.fill,0,0,w,h)

e.glow.Visible=C.glow
e.glow.ImageTransparency=C.glowTransparency
rect(e.glow,-13,-13,w+26,h+26)

local full=C.mode=="full"
e.full.Visible=full
rect(e.full,0,0,w,h)
e.fullStroke.Transparency=0
e.fullStroke.Thickness=2

for i,v in ipairs(p)do
local q=positions[i]
local back,front=v[1],v[2]
back.Visible=not full and C.outline
front.Visible=not full
if not full then
rect(front,q[1],q[2],q[3],q[4])
rect(back,q[1]-1,q[2]-1,q[3]+2,q[4]+2)
back.BackgroundTransparency=C.outlineTransparency
end
end

if full and C.outline then
if not e.fullOutline then
e.fullOutline=frame(e.holder,3)
e.fullOutline.BackgroundTransparency=1
e.fullOutlineStroke=stroke(e.fullOutline,4,.8,dark)
end
e.fullOutline.Visible=true
rect(e.fullOutline,0,0,w,h)
e.fullOutlineStroke.Transparency=C.outlineTransparency
else
if e.fullOutline then e.fullOutline.Visible=false end
end
end

local function newBar()
local holder=frame(gui,5)
holder.BackgroundTransparency=1
holder.Visible=false

local e={holder=holder,smooth=1}
e.glow=glow(holder,4)

e.back=frame(holder,5)
e.back.BackgroundColor3=dark

e.outline=stroke(e.back,1,0,dark)

e.clip=frame(e.back,6)
e.clip.BackgroundTransparency=1
e.clip.ClipsDescendants=true

e.fill=frame(e.clip,6)
gradient(e.fill,hpColors,90)

e.text=Instance.new("TextLabel")
e.text.BackgroundTransparency=1
e.text.TextColor3=Color3.new(1,1,1)
e.text.TextStrokeTransparency=.35
e.text.Font=Enum.Font.GothamBold
e.text.TextSize=12
e.text.TextXAlignment=Enum.TextXAlignment.Center
e.text.ZIndex=8
e.text.Parent=holder

return e
end

local function drawBar(e,x,y,h,hp,maxhp,dt)
local C=A.HC
local ratio=math.clamp(hp/math.max(maxhp,1),0,1)
e.smooth=e.smooth+(ratio-e.smooth)*math.min(1,dt*C.speed)

local width=C.width
local bx=x-C.gap-width
local fillHeight=math.floor(h*e.smooth+.5)

rect(e.holder,bx,y,width,h)
e.holder.Visible=true

rect(e.back,0,0,width,h)
e.outline.Enabled=C.outline

rect(e.clip,0,h-fillHeight,width,fillHeight)
rect(e.fill,0,-(h-fillHeight),width,h)

e.glow.Visible=C.glow
e.glow.ImageTransparency=.72
rect(e.glow,-8,-8,width+16,h+16)

e.text.Visible=C.number
e.text.Text=tostring(math.floor(hp+.5))
rect(e.text,-30,-17,64,16)
end

local function getTeam(obj)
if not obj then return nil end
local t=obj:GetAttribute("Team")
if t~=nil then return tostring(t)end
if obj:IsA("Player") and obj.Team then return obj.Team.Name end
return nil
end

local function myTeam()
return getTeam(LP) or getTeam(LP.Character)
end

local function owner(c)
return P:GetPlayerFromCharacter(c) or P:FindFirstChild(c.Name)
end

local function enemy(c,mine)
if c==LP.Character or c.Name==LP.Name then return false end
local pl=owner(c)
if pl==LP then return false end
local ct=getTeam(c) or getTeam(pl)
if mine and ct then return mine~=ct end
if pl and pl~=LP then return true end
if c:GetAttribute("Bot")==true then return true end
return true
end

local function health(c)
if c:GetAttribute("Dead")==true then return 0,100 end
local hum=c:FindFirstChildOfClass("Humanoid")
local hp=c:GetAttribute("Health")
local maxhp=c:GetAttribute("MaxHealth")
if typeof(hp)~="number" then hp=hum and hum.Health or 100 end
if typeof(maxhp)~="number" then maxhp=hum and hum.MaxHealth or 100 end
return hp,math.max(maxhp,1)
end

local function root(c)
return c:FindFirstChild("HumanoidRootPart")
or c:FindFirstChild("UpperTorso")
or c:FindFirstChild("Torso")
or c:FindFirstChild("LowerTorso")
or c:FindFirstChild("Head")
or c.PrimaryPart
or c:FindFirstChildWhichIsA("BasePart",true)
end

local function bounds(c,r)
local head=c:FindFirstChild("Head")
local top,bottom

if head and head:IsA("BasePart")then
top=head.Position+Vector3.new(0,head.Size.Y*.8+.25,0)
end

local minY,maxY=math.huge,-math.huge
local count=0

for _,v in ipairs(c:GetDescendants())do
if v:IsA("BasePart") and count<35 then
count=count+1
local y=v.Position.Y
local half=v.Size.Y*.5
minY=math.min(minY,y-half)
maxY=math.max(maxY,y+half)
end
end

if count==0 then return nil end
if not top then top=Vector3.new(r.Position.X,maxY+.25,r.Position.Z)end
bottom=Vector3.new(r.Position.X,minY-.15,r.Position.Z)

if top.Y-bottom.Y<1 then
top=r.Position+Vector3.new(0,2.8,0)
bottom=r.Position-Vector3.new(0,2.8,0)
end

return top,bottom
end

local function collect()
local result={}
local folder=W:FindFirstChild("Characters")

if folder then
for _,c in ipairs(folder:GetChildren())do
if c:IsA("Model")then result[c]=true end
end
end

for _,pl in ipairs(P:GetPlayers())do
if pl~=LP and pl.Character then result[pl.Character]=true end
end

return result
end

local function remove(map,c)
local e=map[c]
if e then
e.holder:Destroy()
map[c]=nil
end
end

local function render(dt)
if not A.Active then return end

local C,H=A.C,A.HC
if not C.enabled and not H.enabled then
for c in pairs(A.Boxes)do remove(A.Boxes,c)end
for c in pairs(A.Bars)do remove(A.Bars,c)end
return
end

local cam=W.CurrentCamera
if not cam then return end

local seen={}
local mine=myTeam()

for c in pairs(collect())do
local hp,maxhp=health(c)

if c.Parent and hp>0 and enemy(c,mine)then
local r=root(c)

if r then
local top,bottom=bounds(c,r)

if top and bottom then
local t=cam:WorldToViewportPoint(top)
local b=cam:WorldToViewportPoint(bottom)

if t.Z>0 and b.Z>0 then
local h=math.abs(b.Y-t.Y)
local w=h*.5
local x=(t.X+b.X)*.5-w*.5
local y=math.min(t.Y,b.Y)
local size=cam.ViewportSize

if h>=3 and x+w>=0 and x<=size.X and y+h>=0 and y<=size.Y then
x=math.floor(x+.5)
y=math.floor(y+.5)
w=math.max(3,math.floor(w+.5))
h=math.max(3,math.floor(h+.5))
seen[c]=true

if C.enabled then
local e=A.Boxes[c]
if not e then
e=newBox()
A.Boxes[c]=e
end
drawBox(e,x,y,w,h)
end

if H.enabled then
local e=A.Bars[c]
if not e then
e=newBar()
A.Bars[c]=e
end
drawBar(e,x,y,h,hp,maxhp,dt)
end
end
end
end
end
end
end

for c in pairs(A.Boxes)do
if not seen[c] or not C.enabled then remove(A.Boxes,c)end
end

for c in pairs(A.Bars)do
if not seen[c] or not H.enabled then remove(A.Bars,c)end
end
end

local lastError=0
A.Connections[#A.Connections+1]=R.RenderStepped:Connect(function(dt)
local ok,err=pcall(render,dt)
if not ok and os.clock()-lastError>3 then
lastError=os.clock()
warn("[AURORA ESP RENDER]",err)
end
end)

function A:Stop()
if not self.Active then return end
self.Active=false
for _,c in ipairs(self.Connections)do
pcall(function()c:Disconnect()end)
end
for c in pairs(self.Boxes)do remove(self.Boxes,c)end
for c in pairs(self.Bars)do remove(self.Bars,c)end
if self.VisualGui then self.VisualGui:Destroy()end
end

