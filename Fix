local function register(name,obj,tab)
Registry[#Registry+1]={name=name,obj=obj,tab=tab}
return obj
end

local function toggle(tab,title,value,callback)
local obj=tab:Toggle({
Title=title,
Value=value,
Callback=callback
})
return register(title,obj,tab)
end

local function slider(tab,title,value,min,max,step,callback)
local obj=tab:Slider({
Title=title,
Value={Min=min,Max=max,Default=value},
Step=step,
Callback=callback
})
return register(title,obj,tab)
end

local function dropdown(tab,title,values,value,callback)
local obj=tab:Dropdown({
Title=title,
Values=values,
Value=value,
Callback=callback
})
return register(title,obj,tab)
end

