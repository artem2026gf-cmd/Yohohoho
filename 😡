local function Team(c)
    if not c then return nil end
    local t=c:GetAttribute("Team")
    if t~=nil then return tostring(t)end
    local pl=P:GetPlayerFromCharacter(c)
    if pl then
        t=pl:GetAttribute("Team")
        if t~=nil then return tostring(t)end
        if pl.Team then return pl.Team.Name end
    end
    local armor=c:FindFirstChild("CharacterArmor")
    if armor then
        if armor:FindFirstChild("VestDetails")then return "Counter-Terrorists"end
        if armor:FindFirstChild("Balaclava")then return "Terrorists"end
    end
end

local function MyTeam()
    local t=LP:GetAttribute("Team")
    if t~=nil then return tostring(t)end
    if LP.Team then return LP.Team.Name end
    local folder=W:FindFirstChild("Characters")
    return Team((folder and folder:FindFirstChild(LP.Name)) or LP.Character)
end

local function Enemy(c,team)
    if c==LP.Character or c.Name==LP.Name then return false end
    local pl=P:GetPlayerFromCharacter(c)
    if pl==LP then return false end
    local ct=Team(c)
    if team and ct then return team~=ct end
    if pl then
        if LP.Team and pl.Team then return LP.Team~=pl.Team end
        return true
    end
    return c:GetAttribute("Bot")==true
end

local function Alive(c)
    if c:GetAttribute("Dead")==true then return false end
    local hp=c:GetAttribute("Health")
    if type(hp)=="number" and hp<=0 then return false end
    local hum=c:FindFirstChildOfClass("Humanoid")
    if hum and hum.Health<=0 then return false end
    return c:FindFirstChild("Head")~=nil
end

local function Root(c)
    return c:FindFirstChild("HumanoidRootPart")
        or c:FindFirstChild("UpperTorso")
        or c:FindFirstChild("Torso")
        or c.PrimaryPart
end

local function Bounds(c,r)
    local top,bot=-math.huge,math.huge
    for _,p in ipairs(c:GetChildren())do
        if p:IsA("BasePart")then
            local y=p.Position.Y-r.Position.Y
            local h=p.Size.Y*.5
            top=math.max(top,y+h)
            bot=math.min(bot,y-h)
        end
    end
    if top==-math.huge then return end
    return r.Position+Vector3.new(0,top+.08,0),
           r.Position+Vector3.new(0,bot-.08,0)
end

local function Collect()
    local list={}
    local folder=W:FindFirstChild("Characters")
    if folder then
        for _,c in ipairs(folder:GetChildren())do
            if c:IsA("Model")then list[c]=true end
        end
    end
    for _,pl in ipairs(P:GetPlayers())do
        if pl~=LP and pl.Character then list[pl.Character]=true end
    end
    return list
end

local function Rect(f,x,y,w,h)
    f.Position=UDim2.fromOffset(x,y)
    f.Size=UDim2.fromOffset(math.max(1,w),math.max(1,h))
    f.Visible=true
end

local function MakeBox(c)
    local holder=F(G,1)
    holder.Name="Box_"..c.Name
    holder.Size=UDim2.fromScale(1,1)
    holder.Visible=true

    local glow=N("ImageLabel",holder,{
        BackgroundTransparency=1,
        Image="rbxassetid://18245826428",
        ImageColor3=L,ImageTransparency=.9,
        ScaleType=Enum.ScaleType.Slice,
        SliceCenter=Rect.new(21,21,79,79),
        Visible=false,ZIndex=2
    })

    local fill=F(holder,3)
    fill.BackgroundColor3=Color3.new(1,1,1)
    fill.BackgroundTransparency=0
    local fg=N("UIGradient",fill,{Color=Colors,Rotation=90})

    local back=F(holder,4)
    local bs=N("UIStroke",back,{
        Color=Dark,Thickness=3,Transparency=.8,
        ApplyStrokeMode=Enum.ApplyStrokeMode.Border
    })

    local full=F(holder,5)
    local st=N("UIStroke",full,{
        Color=Color3.new(1,1,1),Thickness=1,
        ApplyStrokeMode=Enum.ApplyStrokeMode.Border
    })
    N("UIGradient",st,{Color=Colors,Rotation=90})

    local lines={}
    for i=1,8 do
        local b=N("Frame",holder,{
            BackgroundColor3=Dark,BackgroundTransparency=.8,
            BorderSizePixel=0,Visible=false,ZIndex=4
        })
        local f=N("Frame",holder,{
            BackgroundColor3=Color3.new(1,1,1),
            BorderSizePixel=0,Visible=false,ZIndex=5
        })
        N("UIGradient",f,{Color=Colors,Rotation=90})
        lines[i]={b,f}
    end

    return {holder=holder,glow=glow,fill=fill,fg=fg,back=back,bs=bs,full=full,lines=lines}
end

local function DrawBox(e,x,y,w,h)
    local function Seg(l,sx,sy,sw,sh)
        if C.outline then
            l[1].BackgroundTransparency=C.outlineTransparency
            Rect(l[1],sx-1,sy-1,sw+2,sh+2)
        else l[1].Visible=false end
        Rect(l[2],sx,sy,sw,sh)
    end

    if C.filled then
        Rect(e.fill,x,y,w,h)
        local t=C.filledTransparency
        e.fg.Transparency=NumberSequence.new({
            NumberSequenceKeypoint.new(0,math.clamp(t+.12,0,1)),
            NumberSequenceKeypoint.new(.5,math.clamp(t-.12,0,1)),
            NumberSequenceKeypoint.new(1,math.clamp(t+.08,0,1))
        })
    else e.fill.Visible=false end

    if C.glow then
        e.glow.ImageTransparency=C.glowTransparency
        Rect(e.glow,x-6,y-6,w+12,h+12)
    else e.glow.Visible=false end

    if C.mode=="full"then
        for _,l in ipairs(e.lines)do
            l[1].Visible=false
            l[2].Visible=false
        end
        Rect(e.full,x,y,w,h)
        if C.outline then
            e.bs.Transparency=C.outlineTransparency
            Rect(e.back,x,y,w,h)
        else e.back.Visible=false end
    else
        e.full.Visible=false
        e.back.Visible=false
        local cw=math.min(math.floor(w*.5),math.max(5,math.floor(w*.28+.5)))
        local ch=math.min(math.floor(h*.5),math.max(5,math.floor(h*.28+.5)))
        Seg(e.lines[1],x,y,cw,1)
        Seg(e.lines[2],x,y,1,ch)
        Seg(e.lines[3],x+w-cw,y,cw,1)
        Seg(e.lines[4],x+w-1,y,1,ch)
        Seg(e.lines[5],x+w-cw,y+h-1,cw,1)
        Seg(e.lines[6],x+w-1,y+h-ch,1,ch)
        Seg(e.lines[7],x,y+h-1,cw,1)
        Seg(e.lines[8],x,y+h-ch,1,ch)
    end
end

local function GetHealth(c)
    local hp=c:GetAttribute("Health")
    local max=c:GetAttribute("MaxHealth")
    if type(hp)=="number"then return hp,type(max)=="number" and max>0 and max or 100 end
    local hum=c:FindFirstChildOfClass("Humanoid")
    if hum then return hum.Health,hum.MaxHealth end
    return 100,100
end

