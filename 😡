local function scroll(obj)
    if not obj or not obj.ElementFrame then return end
    local f=obj.ElementFrame
    local c=f
    while c do
        if c:IsA("ScrollingFrame")then
            pcall(function()
                local y=f.AbsolutePosition.Y-c.AbsolutePosition.Y
                    +c.CanvasPosition.Y-60
                c.CanvasPosition=Vector2.new(0,math.max(0,y))
            end)
            return
        end
        c=c.Parent
    end
end

