local function DrawHealth(e,x,y,h,hp,max,dt)
    local f=math.clamp(hp/math.max(1,max),0,1)
    e.smooth=e.smooth and e.smooth+(f-e.smooth)*math.min(1,dt*HC.speed) or f
    local bx=x-HC.gap-HC.width
    local filled=math.floor(h*e.smooth+.5)

    Rect(e.back,bx,y,HC.width,h)
    e.outline.Enabled=HC.outline
    e.clip.Position=UDim2.fromOffset(0,h-filled)
    e.clip.Size=UDim2.fromOffset(HC.width,filled)
    e.fill.Position=UDim2.fromOffset(0,-(h-filled))
    e.fill.Size=UDim2.fromOffset(HC.width,h)

    e.glow.Visible=HC.glow
    if HC.glow then Rect(e.glow,bx-4,y-4,HC.width+8,h+8)end

    e.number.Visible=HC.number
    if HC.number then
        e.number.Text=tostring(math.floor(hp+.5))
        e.number.Position=UDim2.fromOffset(bx-5,y+h-filled)
    end
end

local function Render(dt)
    if not A.Active then return end
    local cam=W.CurrentCamera
    local seen={}

    for _,e in pairs(A.Entries)do
        e.holder.Visible=false
    end
    for _,e in pairs(A.HealthEntries)do
        e.holder.Visible=false
    end

    if not cam or (not C.enabled and not HC.enabled)then return end
    local team=MyTeam()

    for c in pairs(Collect())do
        if c.Parent and Enemy(c,team) and Alive(c)then
            local root=Root(c)
            if root and (root.Position-cam.CFrame.Position).Magnitude<=500 then
                local top,bot=Bounds(c,root)
                if top and bot then
                    local t,ton=cam:WorldToScreenPoint(top)
                    local b,bon=cam:WorldToScreenPoint(bot)

                    if ton and bon and t.Z>0 and b.Z>0 then
                        local h=math.abs(b.Y-t.Y)
                        if h>=2 then
                            local w=h*.5
                            local x=math.floor((t.X+b.X-w)*.5+.5)
                            local y=math.floor(math.min(t.Y,b.Y)+.5)
                            w=math.max(2,math.floor(w+.5))
                            h=math.max(2,math.floor(h+.5))

                            if C.enabled then
                                local e=A.Entries[c]
                                if not e then e=MakeBox(c)A.Entries[c]=e end
                                e.holder.Visible=true
                                DrawBox(e,x,y,w,h)
                            end

                            if HC.enabled then
                                local e=A.HealthEntries[c]
                                if not e then e=MakeHealth(c)A.HealthEntries[c]=e end
                                e.holder.Visible=true
                                local hp,max=GetHealth(c)
                                DrawHealth(e,x,y,h,hp,max,dt)
                            end
                            seen[c]=true
                        end
                    end
                end
            end
        end
    end

    for c,e in pairs(A.Entries)do
        if not seen[c] or not C.enabled then
            e.holder:Destroy()
            A.Entries[c]=nil
        end
    end
    for c,e in pairs(A.HealthEntries)do
        if not seen[c] or not HC.enabled then
            e.holder:Destroy()
            A.HealthEntries[c]=nil
        end
    end
end

A.Connections[#A.Connections+1]=R.RenderStepped:Connect(Render)

function A:Stop()
    if not self.Active then return end
    self.Active=false
    for _,c in ipairs(self.Connections)do c:Disconnect()end
    for _,e in pairs(self.Entries)do e.holder:Destroy()end
    for _,e in pairs(self.HealthEntries)do e.holder:Destroy()end
    self.Gui:Destroy()
    if E.AuroraHubV3==self then E.AuroraHubV3=nil end
end

